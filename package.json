{
  "name": "btm-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-vad.mjs && next dev",
    "build": "node scripts/copy-vad.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test \"tests/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:local": "node --import tsx scripts/db/local.ts",
    "db:tests-securite": "node --import tsx scripts/db/tests-securite.ts",
    "db:sauvegarde": "node --import tsx scripts/db/sauvegarde.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@breezystack/lamejs": "1.2.7",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.69.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "onnxruntime-web": "^1.31.1",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
