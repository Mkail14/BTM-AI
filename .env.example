# Copiez ce fichier en .env.local et complétez-le. Ne commitez jamais .env.local.

# --- Fournisseur d'IA (côté serveur uniquement, jamais NEXT_PUBLIC_) ---------
# "anthropic" (Claude, SDK officiel) ou "openai-compatible"
# (OpenAI, Mistral, OpenRouter, Groq, Ollama… : API /chat/completions).
AI_PROVIDER=anthropic
AI_API_KEY=
# Anthropic : claude-opus-5-5 par défaut (claude-sonnet-5-5 ou claude-haiku-5-5 pour réduire les coûts).
# openai-compatible : obligatoire (ex. mistral-large-latest).
AI_MODEL=claude-opus-5-5
# Obligatoire pour openai-compatible (ex. https://api.mistral.ai/v1). Optionnel pour anthropic.
AI_BASE_URL=
# Plafond de tokens générés par réponse (limite de coût).
AI_MAX_OUTPUT_TOKENS=4096
# Délai maximal d'une génération, en millisecondes.
AI_TIMEOUT_MS=60000
# Anthropic uniquement : low | medium | high | xhigh | max (low convient au chat et coûte moins).
AI_EFFORT=low
# openai-compatible (OpenRouter) : true coupe la réflexion des modèles qui
# « pensent » avant de répondre (premier mot beaucoup plus rapide).
AI_DISABLE_REASONING=false

# Chiffre les clés des API ajoutées depuis /admin/modele-ia (table ai_providers).
# Facultatif : à défaut, dérivé de SUPABASE_SECRET_KEY. Le changer rend les clés
# déjà enregistrées illisibles (à ressaisir). Ex. : openssl rand -hex 32
AI_KEYS_SECRET=

# --- API de secours (facultatif, jusqu'à AI_5_*) ------------------------------
# Essayées dans l'ordre quand la précédente est épuisée, refuse la clé ou est
# en panne. Chaque variable absente reprend celle de l'API principale (sauf la
# clé) ; si AI_n_PROVIDER est donné, le modèle et l'adresse ne sont pas repris.
# État de chaque API : /admin/modele-ia.
# AI_2_API_KEY=
# AI_2_PROVIDER=openai-compatible
# AI_2_BASE_URL=https://api.groq.com/openai/v1
# AI_2_MODEL=llama-3.3-70b-versatile
# AI_2_LABEL=Groq secours

# --- Supabase ---------------------------------------------------------------
# Publiques par conception (la sécurité repose sur RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRÈTE : clé « secret » (ou service_role). Utilisée uniquement pour les
# compteurs de limitation de débit. Sans elle, compteurs en mémoire (dev uniquement).
SUPABASE_SECRET_KEY=

# --- Limitation de débit ----------------------------------------------------
# Chaîne aléatoire longue (ex. : openssl rand -hex 32). Sert à hacher les IP.
RATE_LIMIT_SALT=

# --- Surveillance du site de La Poste ---------------------------------------
# Code secret de /api/cron/laposte, appelée toutes les 2 h par GitHub
# (.github/workflows/surveillance-laposte.yml). Même valeur dans les secrets
# GitHub du dépôt. Ex. : openssl rand -hex 32
CRON_SECRET=

# --- Portefeuille (paiement Stripe) -----------------------------------------
# Clé secrète Stripe (sk_test_… pour essayer, sk_live_… en vrai). Sans elle,
# la page Portefeuille s'affiche mais la recharge est fermée.
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_…) : Stripe → Développeurs → Webhooks → ajouter
# https://<site>/api/wallet/webhook, événements checkout.session.*.
STRIPE_WEBHOOK_SECRET=

# --- E-mails (envoyés depuis contact@btm.yt) --------------------------------
# Mot de passe de la boîte contact@btm.yt chez OVH : le site envoie par le
# serveur SMTP d'OVH (ssl0.ovh.net, port 465). Sans lui, aucun e-mail du site.
SMTP_PASSWORD=
# Facultatifs : SMTP_USER (défaut contact@btm.yt), SMTP_HOST (défaut ssl0.ovh.net), SMTP_PORT (défaut 465).
# Secret du « Send Email Hook » de Supabase (v1,whsec_…) : Authentication →
# Hooks → Send Email → HTTPS, URL https://<site>/api/auth/email-hook.
# Supabase confie alors ses e-mails (bienvenue, mot de passe oublié) au site.
SEND_EMAIL_HOOK_SECRET=
# Adresse publique du site pour les liens et le logo des e-mails (facultatif).
SITE_URL=

# --- Devis BTM (btm.yt) dans la conversation ---------------------------------
# Fonction Supabase « devis-tamilya » du site BTM : prix à jour et
# enregistrement du devis dans le compte btm.yt de même adresse e-mail (code
# de retrait). Le secret est le même que TAMILYA_SECRET de la fonction.
# Ex. : openssl rand -hex 32. Sans eux, le devis s'ouvre sur btm.yt.
BTM_DEVIS_URL=
BTM_DEVIS_SECRET=

# --- Tamilya Connect (messages relayés de téléphone en téléphone) ------------
# Clé privée P-256 du serveur, PKCS#8 DER en base64. Sans elle, Tamilya Connect est fermé.
# Ex. : node -e "const c=require('crypto');console.log(c.generateKeyPairSync('ec',{namedCurve:'prime256v1'}).privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
# La changer oblige chaque app à relire la clé publique (/api/mesh/key) avec internet.
MESH_PRIVATE_KEY=
